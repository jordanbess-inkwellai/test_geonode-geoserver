# GeoNode-GeoServer Integration Test Configuration Template
# Copy this file to .env and update the values for your environment

# =============================================================================
# SERVICE URLS
# =============================================================================
# Base URL of your GeoNode instance
GEONODE_URL=http://localhost:8000

# Base URL of your GeoServer instance
GEOSERVER_URL=http://localhost:8080/geoserver

# =============================================================================
# AUTHENTICATION
# =============================================================================
# Username for GeoNode/GeoServer authentication
GEONODE_USERNAME=admin

# Password for GeoNode/GeoServer authentication
# SECURITY NOTE: Use a secure password and consider using a secrets manager
GEONODE_PASSWORD=geoserver

# =============================================================================
# TEST DATA PATHS
# =============================================================================
# Path to sample shapefile for testing (relative to project root)
SAMPLE_SHAPEFILE_PATH=./data/sample_vector.shp

# Path to sample raster file for testing (relative to project root)
SAMPLE_RASTER_PATH=./data/sample_raster.tif

# =============================================================================
# TIMEOUT AND RETRY SETTINGS
# =============================================================================
# Default timeout for HTTP requests (seconds)
DEFAULT_TIMEOUT=30

# Timeout for file upload operations (seconds)
UPLOAD_TIMEOUT=180

# Maximum number of retry attempts for failed requests
MAX_RETRY_ATTEMPTS=3

# =============================================================================
# FILE SIZE LIMITS
# =============================================================================
# Maximum file size for uploads (MB)
MAX_FILE_SIZE_MB=100

# =============================================================================
# WORKSPACE SETTINGS
# =============================================================================
# Default GeoServer workspace name
DEFAULT_WORKSPACE=geonode

# =============================================================================
# TEST CONFIGURATION
# =============================================================================
# Enable cleanup of temporary files after tests (true/false)
ENABLE_CLEANUP=false

# Enable verbose logging for debugging (true/false)
VERBOSE_LOGGING=false

# Test environment identifier (development/staging/production)
TEST_ENVIRONMENT=development

# =============================================================================
# OPTIONAL SETTINGS
# =============================================================================
# Webhook URL for test result notifications (optional)
NOTIFICATION_WEBHOOK=

# Output directory for test results (relative to project root)
OUTPUT_DIR=./output

# =============================================================================
# SSL/TLS SETTINGS
# =============================================================================
# Verify SSL certificates (true/false)
VERIFY_SSL=true

# Path to SSL certificate file (optional)
SSL_CERT_PATH=

# =============================================================================
# LOGGING CONFIGURATION
# =============================================================================
# Log level (DEBUG/INFO/WARNING/ERROR/CRITICAL)
LOG_LEVEL=INFO

# Log file path (optional - if not set, logs to console only)
LOG_FILE=

# =============================================================================
# ADVANCED SETTINGS
# =============================================================================
# Custom user agent for HTTP requests
USER_AGENT=GeoNode-GeoServer-Test-Suite/1.0

# Request timeout for health checks (seconds)
HEALTH_CHECK_TIMEOUT=10

# Interval between retry attempts (seconds)
RETRY_BACKOFF_FACTOR=1

# Maximum time to wait for layer publishing (seconds)
LAYER_PUBLISH_TIMEOUT=300

# =============================================================================
# DEVELOPMENT SETTINGS
# =============================================================================
# Enable debug mode for development (true/false)
DEBUG_MODE=false

# Save intermediate test data for debugging (true/false)
SAVE_DEBUG_DATA=false

# Skip certain tests for faster development cycles (comma-separated list)
SKIP_TESTS=

# =============================================================================
# PRODUCTION SETTINGS
# =============================================================================
# Enable strict SSL verification in production (true/false)
STRICT_SSL=true

# Enable audit logging (true/false)
AUDIT_LOGGING=false

# Maximum concurrent connections
MAX_CONNECTIONS=10

# =============================================================================
# MONITORING AND ALERTING
# =============================================================================
# Enable performance monitoring (true/false)
ENABLE_MONITORING=false

# Threshold for slow request warnings (seconds)
SLOW_REQUEST_THRESHOLD=5

# Enable email notifications for test failures (true/false)
EMAIL_NOTIFICATIONS=false

# SMTP server for email notifications
SMTP_SERVER=

# Email recipients for notifications (comma-separated)
EMAIL_RECIPIENTS=

# =============================================================================
# EXAMPLE CONFIGURATIONS
# =============================================================================

# Example: Local development environment
# GEONODE_URL=http://localhost:8000
# GEOSERVER_URL=http://localhost:8080/geoserver
# GEONODE_USERNAME=admin
# GEONODE_PASSWORD=admin
# VERBOSE_LOGGING=true
# ENABLE_CLEANUP=false

# Example: Staging environment
# GEONODE_URL=https://staging-geonode.example.com
# GEOSERVER_URL=https://staging-geoserver.example.com/geoserver
# GEONODE_USERNAME=test_user
# GEONODE_PASSWORD=secure_staging_password
# VERIFY_SSL=true
# TEST_ENVIRONMENT=staging

# Example: Production environment
# GEONODE_URL=https://geonode.example.com
# GEOSERVER_URL=https://geoserver.example.com/geoserver
# GEONODE_USERNAME=prod_test_user
# GEONODE_PASSWORD=very_secure_production_password
# VERIFY_SSL=true
# STRICT_SSL=true
# TEST_ENVIRONMENT=production
# ENABLE_CLEANUP=true
# AUDIT_LOGGING=true
